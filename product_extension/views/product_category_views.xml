<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add code field next to name in product category form view -->
    <record id="view_product_category_form_code" model="ir.ui.view">
        <field name="name">product.category.form.code</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <!-- Add code field on the same line as name -->
            <xpath expr="//div[@class='oe_title']/h1/field[@name='name']" position="after">
                <field name="code" class="ms-2" placeholder="Code"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Reference Configuration">
                    <field name="reference_type"/>
                    
                    <!-- Automatic mode: Show sequence field -->
                    <field name="reference_sequence_id"
                           invisible="reference_type != 'automatic'"
                           help="Sequence to use for automatic reference generation. If not set, the default sequence will be used."/>
                    
                    <!-- Validation mode: Show validation fields -->
                    <field name="validation_mode"
                           invisible="reference_type != 'validation'"
                           help="Validation mode for internal references"/>
                    <field name="reference_length"
                           invisible="reference_type != 'validation' or validation_mode != 'length'"
                           help="Required length for internal references"/>
                    <field name="reference_char_type"
                           invisible="reference_type != 'validation' or validation_mode != 'type'"
                           help="Character type allowed in internal references"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

